{
  "name": "@devkit/server",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/index.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --deny-warnings src tests vite.config.ts",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.conformance/vitest.json"
  },
  "dependencies": {
    "@devframes/hub": "1.0.0",
    "@devkit/client": "workspace:*",
    "@devkit/core": "workspace:*",
    "@devkit/devframe": "workspace:*",
    "@devkit/runtime": "workspace:*",
    "@vitejs/devtools-kit": "0.7.5",
    "cac": "7.0.0",
    "devframe": "1.0.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@devkit/example-contribution": "workspace:*",
    "@devkit/webext": "workspace:*"
  }
}
