{
  "name": "@devkit/server",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --deny-warnings src tests vite.config.ts",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check .",
    "test": "vitest run"
  },
  "dependencies": {
    "@devframes/hub": "1.0.0",
    "@devkit/core": "workspace:*",
    "@devkit/runtime": "workspace:*",
    "@vitejs/devtools-kit": "0.7.5",
    "cac": "7.0.0",
    "devframe": "1.0.0"
  },
  "devDependencies": {
    "zod": "4.6.5"
  }
}
