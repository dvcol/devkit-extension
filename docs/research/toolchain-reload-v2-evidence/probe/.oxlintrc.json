{
  "plugins": [
    "typescript",
    "import",
    "unicorn"
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "rules": {
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error"
  },
  "overrides": [
    {
      "files": [
        "scripts/*.ts"
      ],
      "rules": {
        "eslint/no-await-in-loop": "off"
      }
    },
    {
      "files": [
        "fixtures/custom/page.ts",
        "fixtures/wxt/page.ts"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    }
  ]
}
