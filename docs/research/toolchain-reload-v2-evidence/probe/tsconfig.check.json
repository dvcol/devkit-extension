{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": [
      "node",
      "vite/client",
      "chrome"
    ],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ]
  },
  "include": [
    "shared/**/*.ts",
    "fixtures/wxt/**/*.ts",
    "fixtures/custom/**/*.ts",
    "scripts/**/*.ts",
    "fixtures/wxt/.wxt/**/*.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/.output",
    "**/dist*"
  ]
}
