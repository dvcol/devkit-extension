+it.each(['resolve', 'reject'] as const)('does not reply when an incoming handler finishes with %s after close', async (outcome) => {
+  expect.assertions(6)
+  let receiveServer: (message: unknown) => unknown = () => {}
+  let delivery: Promise<unknown> | undefined
+  let started = false
+  let completed = 0
+  const completion = Promise.withResolvers<void>()
+  const failure = new Error('Handler failed after close')
+  const functions = {
+    wait: async () => {
+      started = true
+      await completion.promise
+      completed += 1
+      if (outcome === 'reject')
+        throw failure
+      return 42
+    },
+  }
+  const post = vi.fn()
+  const serialize = vi.fn((message: unknown) => message)
+  const onFunctionError = vi.fn()
+  const server = createBirpc(functions, {
+    post,
+    serialize,
+    onFunctionError,
+    on(handler) { receiveServer = handler },
+  })
+  const client = createBirpc<typeof functions>({}, {
+    on() {},
+    post(message) {
+      const handling = receiveServer(message)
+      if (handling instanceof Promise)
+        delivery = handling
+    },
+  })
+  const pending = client.wait()
+  try {
+    await expect.poll(() => started).toBe(true)
+    server.$close()
+    client.$close()
+    await expect(pending).rejects.toThrow('closed')
+    completion.resolve()
+    await delivery
+    expect(completed).toBe(1)
+    expect(post).not.toHaveBeenCalled()
+    expect(serialize).not.toHaveBeenCalled()
+    if (outcome === 'reject')
+      expect(onFunctionError).toHaveBeenCalledWith(failure, 'wait', [])
+    else
+      expect(onFunctionError).not.toHaveBeenCalled()
+  }
+  finally {
+    completion.resolve()
+    client.$close()
+    server.$close()
+  }
+})
