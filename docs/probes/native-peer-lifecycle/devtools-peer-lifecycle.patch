diff --git a/packages/core/src/node/__tests__/server-peer-lifecycle.test.ts b/packages/core/src/node/__tests__/server-peer-lifecycle.test.ts
new file mode 100644
index 0000000..ca677a8
--- /dev/null
+++ b/packages/core/src/node/__tests__/server-peer-lifecycle.test.ts
@@ -0,0 +1,64 @@
+import type { InitHubOptions } from '@devframes/hub/initiate'
+import type { ViteDevToolsNodeContext } from '@vitejs/devtools-kit'
+import { beforeEach, describe, expect, it, vi } from 'vitest'
+import { createDevToolsHub } from '../server'
+
+const initHub = vi.hoisted(() => vi.fn())
+
+vi.mock('@devframes/hub/initiate', () => ({ initHub }))
+
+vi.mock('@devframes/json-render-ui/hub', () => ({
+  jsonRenderUiRenderer: () => ({ type: 'json-render', file: '/builtin-json-render.mjs' }),
+}))
+
+vi.mock('../ui', () => ({ createViteDevToolsUi: () => ({}) }))
+
+vi.mock('../auth-handler', () => ({
+  getAuthHandler: () => ({ rpcFunctions: [] }),
+  isClientAuthDisabled: () => false,
+  isBuildCapabilityAuth: () => false,
+  getBuildCapabilityToken: () => 'test-capability-token',
+}))
+
+function createContext(): ViteDevToolsNodeContext {
+  return {
+    mode: 'dev',
+    viteConfig: { devtools: undefined },
+    host: { provideConnectionMeta: vi.fn() },
+  } as unknown as ViteDevToolsNodeContext
+}
+
+describe('createDevToolsHub peer lifecycle forwarding', () => {
+  beforeEach(() => {
+    vi.clearAllMocks()
+    initHub.mockReturnValue({
+      ready: Promise.resolve(),
+      connectionMeta: () => ({}),
+      nodeMiddleware: vi.fn(),
+      close: vi.fn(),
+    })
+  })
+
+  it('forwards both callbacks unchanged alongside the supplied context', async () => {
+    expect.assertions(4)
+    const context = createContext()
+    const onPeerConnect = vi.fn<NonNullable<InitHubOptions['onPeerConnect']>>()
+    const onPeerDisconnect = vi.fn<NonNullable<InitHubOptions['onPeerDisconnect']>>()
+
+    await createDevToolsHub({ context, onPeerConnect, onPeerDisconnect })
+
+    expect(initHub).toHaveBeenCalledOnce()
+    expect(initHub.mock.calls[0]![0].context).toBe(context)
+    expect(initHub.mock.calls[0]![0].onPeerConnect).toBe(onPeerConnect)
+    expect(initHub.mock.calls[0]![0].onPeerDisconnect).toBe(onPeerDisconnect)
+  })
+
+  it('leaves peer lifecycle callbacks unset by default', async () => {
+    expect.assertions(3)
+    await createDevToolsHub({ context: createContext() })
+
+    expect(initHub).toHaveBeenCalledOnce()
+    expect(initHub.mock.calls[0]![0].onPeerConnect).toBeUndefined()
+    expect(initHub.mock.calls[0]![0].onPeerDisconnect).toBeUndefined()
+  })
+})
