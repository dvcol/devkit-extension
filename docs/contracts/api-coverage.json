      "examples": [
        "examples/contribution"
      ],
      "evidence": [
        {
          "workspace": "packages/core",
          "testFile": "tests/definitions.test.ts",
          "fullName": "portable definitions preserves contract content and leaves setup, handlers and schema validation inert",
          "host": "node",
          "mode": "unit"
        },
        {
          "workspace": "packages/core",
          "testFile": "tests/definitions.test.ts",
          "fullName": "portable definitions copies and freezes declaration collections without freezing caller data or schemas",
          "host": "node",
          "mode": "unit"
        },
        {
          "workspace": "packages/core",
          "testFile": "tests/definitions.test.ts",
          "fullName": "portable definitions accepts custom realms, exact positive versions and every dedicated plugin list",
          "host": "node",
          "mode": "unit"
        },
        {
          "workspace": "packages/core",
          "testFile": "tests/definitions.test.ts",
          "fullName": "portable definitions retains async and transforming validators for guard-only validation at invocation",
          "host": "node",
          "mode": "unit"
        },
        {
          "workspace": "packages/core",
          "testFile": "tests/definitions.test.ts",
          "fullName": "portable definitions preserves duplicate declarations for the provider admission strictness policy",
          "host": "node",
          "mode": "unit"
        },
        {
          "workspace": "examples/contribution",
          "testFile": "tests/contribution.test.ts",
          "fullName": "UI-free contribution example executes its action and capability through a real provider, then removes its subscription",
          "host": "custom-local-provider",
          "mode": "integration"
        }
      ],
      "gaps": [
        "Only local declarations and one local-provider scenario are linked. Native Devframe, DevTools, Chromium and Firefox host/mode evidence remains to be reconciled under Examples and API coverage contract."
      ]
    },
