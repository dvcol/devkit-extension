{
  "name": "devkit-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Portable contribution contracts and provider integrations for development tools and browser extensions.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dvcol/devkit-extension.git"
  },
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "format:check": "oxfmt --check .",
    "format:write": "oxfmt --write .",
    "test": "turbo run test",
    "tooling:lint": "oxlint --config .oxlintrc.json --deny-warnings scripts commitlint.config.ts lint-staged.config.ts",
    "tooling:typecheck": "tsc --noEmit -p tsconfig.tools.json",
    "tooling:test": "node scripts/check-enforcement.ts",
    "ci": "pnpm run tooling:lint && pnpm run tooling:typecheck && pnpm run tooling:test && pnpm run build && pnpm run artifacts:test && pnpm run typecheck && pnpm run lint && pnpm run format:check && pnpm run test",
    "artifacts:test": "node scripts/check-packages.ts && node scripts/check-example-package.ts"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.2",
    "@commitlint/config-conventional": "21.2.2",
    "@types/node": "26.6.1",
    "husky": "9.1.7",
    "lint-staged": "17.5.1",
    "oxfmt": "0.68.0",
    "oxlint": "1.83.0",
    "oxlint-tsgolint": "7.0.2001",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  },
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=12.5.1"
  },
  "packageManager": "pnpm@12.5.1"
}
