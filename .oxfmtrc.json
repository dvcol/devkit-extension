{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "endOfLine": "lf",
  "ignorePatterns": [
    "**/dist/**",
    "**/coverage/**",
    "pnpm-lock.yaml",
    "docs/probes/**",
    "docs/contracts/**",
    "docs/planning/**"
  ]
}
