{
  "name": "@devkit/example-vite-hosts",
  "version": "0.0.0",
  "private": true,
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "build:site": "vite build --config host.config.ts --mode devframe",
    "build:watch": "node src/build-watch.ts",
    "preview": "node src/production-demo.ts",
    "dev:production": "pnpm --workspace-concurrency=2 run \"/^(build:watch|preview)$/\"",
    "preview:devframe": "node src/preview-demo.ts devframe",
    "preview:devtools": "node src/preview-demo.ts devtools",
    "demo:devframe": "node src/demo.ts devframe",
    "demo:devtools": "node src/demo.ts devtools",
    "inspector:devframe": "vite --config inspector.config.ts --mode devframe",
    "inspector:devtools": "vite --config inspector.config.ts --mode devtools",
    "inspector:build:watch": "node src/inspector-build-watch.ts",
    "inspector:preview": "node src/inspector-production-preview.ts",
    "inspector:dev:production": "pnpm --workspace-concurrency=2 run \"/^inspector:(build:watch|preview)$/\"",
    "test": "vitest run --reporter=default --reporter=json --outputFile=.conformance/vitest.json",
    "test:browser": "node tests/browser.ts",
    "test:inspector": "node tests/inspector-browser.ts",
    "test:inspector:firefox": "node tests/inspector-firefox.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "oxlint --config ../../.oxlintrc.json --type-aware --deny-warnings src site inspector-site tests vite.config.ts host.config.ts inspector.config.ts",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check ."
  },
  "dependencies": {
    "@devframes/hub": "1.0.0",
    "@devframes/json-render": "1.0.0",
    "@devframes/json-render-ui": "1.0.0",
    "@devframes/vite": "1.0.0",
    "@devkit/client": "workspace:*",
    "@devkit/core": "workspace:*",
    "@devkit/devframe": "workspace:*",
    "@devkit/example-contribution": "workspace:*",
    "@devkit/example-json-render": "workspace:*",
    "@devkit/example-server-contexts": "workspace:*",
    "@devkit/server": "workspace:*",
    "@vitejs/devtools": "0.7.5",
    "@vitejs/devtools-kit": "0.7.5",
    "devframe": "1.0.0",
    "vite": "8.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/selenium-webdriver": "4.35.7",
    "selenium-webdriver": "4.49.0"
  }
}
